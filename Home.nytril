using Format;

class DataClass: Fact {
  field bool LoadRecords;

  Constructor {
    super.Constructor(#1e9cb57c-aa58-4d21-82f5-34a1a1650424#);
    ReadFromStorage;
  }
}
//=======================================================

class LoadDataActionClass: Action {
  var DataClass Data;

  Constructor(DataClass data) {
    super.Constructor(Actions.Execute, null);
    Data = data;
  }

  override EventResponse Execute {
    Data.LoadRecords = true;
    Data.WriteToStorage;
    return EventResponses.Rebuild;
  }
}
//=======================================================

class HomeClass: DocumentClass {
  var DataClass                           Data;
  private var List<RawWorkoutClass>  AllRawWorkouts;

  Constructor {
    super.Constructor(#faf514cc-cfcf-42f6-8ae5-91d74b13234e#, Lang.Home);
    Data = new;

    if (Data.LoadRecords)
      LoadRecords;
  }

  void LoadRecords {
    AllRawWorkouts   = AppleWorkoutSessions.RawWorkouts;
    Data.LoadRecords = false;
    Data.WriteToStorage;
  }

  override GetDocument = Document(MarginLayout) {
    Paragraph {
      ParAlignment: ParAlignments.Right;
      TextHeight: 30pt;
      "Run Logix";
    };
    HBox(null, null, BorderAll(1) + PadAll(4)) {
      BorderRadius: 2pt;
      Span {
        Action: new LoadDataActionClass(Data);
        "Read In New Workouts";
      };
    };
    Paragraph;
    Paragraph {
      Span {
        Action: new Action(Actions.ToDocument, SummaryDocument);
        Bold;
        "Summary Document";
      };
    };
    Paragraph {
      LeftIndent: 10pt;
      Italic;
      "This document shows a very basic listing of all workouts completed, any comments, and includes a monthly total distance chart.";
    };
    Paragraph;

    Paragraph {
      Span {
        Action: new Action(Actions.ToDocument, #029a3f5d-ebfd-4011-8d57-7f87c7b6b324#);
        Bold;
        "Workout Performance to Target Document";
      };
    };
    Paragraph {
      LeftIndent: 10pt;
      Italic;
      "This document matches up workouts in storage to scheduled workouts and shows actual performance to expectations";
    };
    Paragraph;
    Paragraph {
      Span {
        Action: new Action(Actions.ToDocument, #82bd5cf5-0150-4e79-95c6-3cb36f7824e9#);
        Bold;
        "Raw Workouts Document";
      };

    };
    Paragraph {
      LeftIndent: 10pt;
      Italic;
      "This document shows every run in storage including splits based on the selected measurement system (either miles or kilometers) and elevation gain/loss per split.";
    };
  };
}




