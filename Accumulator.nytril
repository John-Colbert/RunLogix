using IO, Format;

class ReadingItemClass {
  readonly var DateTime Time;
  readonly var double   Elevation,
                        Meters,
                        Course,
                        HAcc,
                        VAcc;

  Constructor(DateTime time, double elevation, double meters, double course, double hAcc, double vAcc) {
    Time       = time;
    Elevation  = elevation;
    Meters     = meters;
    Course     = course;
    HAcc       = hAcc;
    VAcc       = vAcc;
  }
}

class RunSessionClass {
  readonly var string             Filename;
  readonly var List<string>  WorkoutFileNames;
  readonly var ReadingItemClass[] Readings;
  readonly var int                ErrorCount;

  Constructor(string name, List<string>  workoutFileNames, ReadingItemClass[] readings, int errorCount) {
    Filename         = name;
    WorkoutFileNames = workoutFileNames;
    Readings         = readings;
    ErrorCount       = errorCount;
  }
}

class AccumulatorClass {
  var string Filename;
  var string StorageString;

  Constructor() {
    Filename       = "";
    StorageString  = [];
  }

  List<ReadingItemClass> ReadFile(string path, string filename, bool useSourceRoot = false) {
    List<ReadingItemClass> readings = new(100);
    Filename   = filename;
    var dir    = useSourceRoot ? Folders.Source : Folder(path);

    var fullpath = dir FileName(filename); // "/" filename;
    var file = XMLElementClass.Read(fullpath);
    if (file is valid) {
      var gpxEl    = file.FindFirstElement("gpx");
      var trkEl    = gpxEl.FindFirstElement("trk");
      var trkSegEl = trkEl.FindFirstElement("trkseg");
      var trkpts   = trkSegEl.Elements;
      if (trkpts is valid) {
        foreach (var trkptEl in trkpts) {
          var timeEl       = trkptEl.FindFirstElement("time");
          var time         = DateTime.Parse8601(timeEl.Value);

          var eleEl        = trkptEl.FindFirstElement("ele");
          var elevation    = eleEl.Value as double;

          var extensionsEl = trkptEl.FindFirstElement("extensions");
          var speedEl      = extensionsEl.FindFirstElement("speed");
          var course       = extensionsEl.FindFirstElement("course");
          var hAcc         = extensionsEl.FindFirstElement("hAcc");
          var vAcc         = extensionsEl.FindFirstElement("vAcc");
          var v = speedEl.Value;
          if (v is valid)
            readings.Add(new(time, elevation, v as double, course.Value as double, hAcc.Value as double, vAcc.Value as double));
        }
        //List<string> workoutFileNames = new(1);
        //workoutFileNames.Add(filename);
        //RunSessionClass runsession = new(Filename, workoutFileNames, Readings.ToArray);
        //Readings.Clear;
        return readings;
      }
    }
    return null;
  }
}
