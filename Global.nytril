using Format, Units, IO, System;

//======================================================================================
typedef DoubleList ListClass<double>;
typedef RunArray RunSessionClass[];

readonly ThicknessClass MarginLayout = new(1 inch, 0.5 inches, 1 inch, 1 inch);

//======================================================================================

readonly namespace Measures if (UnitSystem == UnitSystems.Metric) {
  const string DistanceAbbr           = " km";
  const string MinutesPerAbbr         = " min/km";
  const double PerMeterFactor         = Measures.KilometersPerMeter;
  const double MetersPerFactor        = Measures.MetersPerKilometer;
  readonly DistanceTypes DistanceType = DistanceTypes.Kilometer;
  const string DistanceUnitSingle     = Kilometer;
  const string DistanceUnitPlural     = Kilometers;
}

readonly namespace Measures if (UnitSystem == UnitSystems.Imperial) {
  const string DistanceAbbr           = " mi";
  const string MinutesPerAbbr         = " min/mi";
  const double PerMeterFactor         = Measures.MilesPerMeter;
  const double MetersPerFactor        = Measures.MetersPerMile;
  readonly DistanceTypes DistanceType = DistanceTypes.Mile;
  const string DistanceUnitSingle     = Mile;
  const string DistanceUnitPlural     = Miles;
}

namespace Measures {
  const double MetersPerKilometer        = (1 kilometer) toscale meters;
  const double KilometersPerMeter        = (1 meter) toscale kilometers;
  const double MetersPerMile             = (1 mile) toscale meters;
  const double MilesPerMeter             = (1 meter) toscale miles;
  const double KilometersPerMile         = (1 mile) toscale kilometers;
  const double MilesPerKilometer         = (1 kilometer) toscale miles;
  const string Kilometer                 = "Kilometer";
  const string Mile                      = "Mile";
  const string Kilometers                = "Kilometers";
  const string Miles                     = "Miles";

  const double MetersToFeetFactor        = 3.280839895;
  const double MinPerMiToMinPerKMFactor  = 0.6213692038495188;
  const double MinPerKmToMinPerMiFactor  = 1.6093491499172796;
}
//======================================================================================

namespace Convert {
  double MinutesToDouble(string minutes) {
    var parts = minutes.Split(":");
    if (parts.Length != 2)
      Assert(false, "Time must be entered as minutes and seconds, with two digits for each (i.e. \"12:01\" or \"01:15\")");

    int paceMinutes = parts[0] as int;
    int paceSeconds = parts[1] as int;

    return paceMinutes + paceSeconds * 0.016666666667;
  }

  double ConvertPace(double pace, PaceTypes fromType) {
    if (fromType == PaceTypes.MinPerMi)
      return pace * Measures.MinPerMiToMinPerKMFactor;
    else
      return pace * Measures.MinPerKmToMinPerMiFactor;
  }

  double ConvertDistance(double distance, DistanceTypes fromType) {
    if (fromType == DistanceTypes.Mile || fromType == DistanceTypes.Miles)
      return distance * Measures.KilometersPerMile;
    else
      return distance * Measures.MilesPerKilometer;
  }
}
//======================================================================================

namespace Utilities {
  ElevationClass GetElevationMetrics(DoubleList elevationReadings) {
    if (elevationReadings.Length <= 0)
      return new ElevationClass(0, 0);

    double start = elevationReadings[0];
    double distanceUp = 0;
    double distanceDown = 0;

    double lastVal = start;

    foreach (var ele in elevationReadings) {
      if (ele > lastVal)
        distanceUp += ele - lastVal;
      else if (ele < lastVal)
        distanceDown += lastVal - ele;

      lastVal = ele;
    }

    if (UnitSystem == UnitSystems.Imperial) {
      distanceUp = distanceUp * Measures.MetersToFeetFactor;
      distanceDown = distanceDown * Measures.MetersToFeetFactor;
    }

    return new ElevationClass(distanceUp, distanceDown);
  }

  GetElevationShape(DoubleList elevationReadings) = Canvas {
    if (elevationReadings.Length <= 0)
      return;

    double width              = (0.75 inches) toscale pixels;
    int readingsPerWidthPixel = elevationReadings.Length > width ? (elevationReadings.Length / width) as int : 1;

    double max = 0;
    double min = double.MaxValue;

    for (int i = 0; i < elevationReadings.Length; i += readingsPerWidthPixel) {
      var e = elevationReadings[i];
      max = Math.Max(e, max);
      min = Math.Min(e, min);
    }

    double diff  = max - min;
    double height = 18;
    double delta  = 6;
    double h = height - delta;

    Shape(Colors.DarkGray, null, null, width, height) {
      ClosedPath(0, height) {
        for (int i = 0; i < elevationReadings.Length; i += readingsPerWidthPixel) {
          var e = elevationReadings[i];

          if (diff == 0)
            LineTo((i / elevationReadings.Length) * width, h - (e - min) / 1); //changed 3/10/25
          else
            LineTo((i / elevationReadings.Length) * width, h - (e - min) / diff * h);
        }
        LineTo(width, height);
      };
    };
  };
}
//======================================================================================

void Progress(string comment, double val) {
  var total = 100;
  ProgressComment(comment);
  ProgressPercent(val, total);
}

enum PaceTypes {
  MinPerKm ("min/km"),
  MinPerMi ("min/mi")
}

enum DistanceTypes {
  Meters,
  Kilometer,
  Mile,
  Kilometers,
  Miles
}
