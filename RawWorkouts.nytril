using IO, Units, System, Format;

class RawWorkoutClass: WorkoutBase {
  var ListClass<DistancePerformance> Splits;
  var DistancePerformance            RemainingDistance;
  var double                         TotalDistance,
                                     TotalTime;
  var ListClass<double>              ElevationReadings;

  Constructor() {
    super.Constructor;
    Splits            = new(2);
    RemainingDistance = new(DistanceTypes.Meters, 0, 0, 0, new(100));
    TotalDistance     = 0;
    TotalTime         = 0;
    ElevationReadings = new(100);
  }

  //string GetStorageString() {
  //  return Accumulator.GetStorageString();
  //}

  void Build(ReadingItemClass[] readings) {
    //ReadFile(file);
    BuildWorkout(readings);
  }

  //void ReadFile(FileEntryClass file) {
  //  Filename = file.FileName;
  //  Accumulator.ReadFile(DataPath, Filename, false);
  //}

  void BuildWorkout(ReadingItemClass[] readings) {
    //var readings = Accumulator.Readings;
    if (readings.Length > 0) {
      StartTime = readings.FirstElement.Time;
      EndTime   = readings.LastElement.Time;
    }

    int i = 0;
    int splitReadings = 0;
    while (i < readings.Length) {
      ElevationReadings.Add(readings[i].Elevation);
      TotalDistance += readings[i++].Meters;
      splitReadings++;

      if (AddSplit(ref splitReadings, ElevationReadings))
        ElevationReadings = new(100);
    }

    if (splitReadings > 0) {
      var time = splitReadings / 60;
      var distance = TotalDistance - Measures.MetersPerFactor * Splits.Length;
      RemainingDistance = new(DistanceTypes.Meters, time, distance, splitReadings, ElevationReadings);
    }

    TotalTime = readings.Length / 60;
  }

  bool AddSplit(ref int splitReadings, DoubleList elevationReadings) {
    double dist = Measures.MetersPerFactor * (Splits.Length + 1);
    if (splitReadings > 20 && TotalDistance >= dist && TotalDistance < dist + 15) {
      var time = splitReadings / 60;
      Splits.Add(new DistancePerformance(Measures.DistanceType, time, 1, splitReadings, elevationReadings));
      splitReadings = 0;
      return true;
    }
    return false;
  }
}
//=================================================================================

typedef RunArray RunSessionClass[];
class RawWorkoutsClass {
  readonly var AccumulatorClass           Accumulator;
  readonly var ListClass<RawWorkoutClass> RawWorkouts;
  readonly var ListClass<RunSessionClass> NewSessions;
  readonly var RunSessionClass[]          WorkoutSessions;

  Constructor {
    Accumulator       = new;
    var fileCount     = Files.Length;
    RawWorkouts          = new(fileCount);
    NewSessions       = new(fileCount);

   // Read storage
    var progressTotal = 100;
    ProgressPercent(0, progressTotal);
    ProgressComment("Reading Stored Run Sessions");
    var build         = ReadScript(DataReadingsPath);
    WorkoutSessions   = build.Root.RunSessions as RunArray;

    // Reconcile the existing to the incoming
    ProgressPercent(10, progressTotal);
    ProgressComment("Reconciling data ");
    ListClass<string> incomingFileNames = new(fileCount);
    foreach (FileEntryClass file in Files)
      incomingFileNames.Add(file.FileName);
    incomingFileNames.Sort;

    ListClass<string> existingFileNames = new(fileCount);
    foreach (RunSessionClass file in WorkoutSessions)
      existingFileNames.Add(file.Filename);
    existingFileNames.Sort;

    bool match = false;
    ListClass<string> toAddFileNames = new(fileCount);
    foreach (var inName in incomingFileNames) {
      match = false;
      foreach (var existingName in existingFileNames) {
        if (existingName == inName) {
          match = true;
          break;
        }
      }
      if (!match)
        toAddFileNames.Add(inName);
    }
    double progress = 25;
    ProgressPercent(progress, progressTotal);

    // Parse the missing incoming files and add to storage and workoutsessions
    var toAddCount = toAddFileNames.Length;
    if (toAddCount > 0) {
      double progressPer = 25 / toAddCount;
      ProgressComment("Reading " toAddCount " GPX Files.");
      //ListClass<RunSessionClass> list = new(toAddFileNames.Length);
      foreach (var filename in toAddFileNames) {
        NewSessions.Add(Accumulator.ReadFile(DataPath, filename, false));
        ProgressPercent(progress += progressPer, progressTotal);
      }
      WorkoutSessions += NewSessions.ToArray;
      ProgressComment("Writing Storage File.");
      WriteStorage();
      progress = 75;
    }
    else {
      progress = 75;
      ProgressPercent(progress, progressTotal);
    }

    //Build the workouts from the existing list
    int sessionCount = WorkoutSessions.Length;
    double progressPer = 25 / sessionCount;
    ProgressComment("Building " sessionCount " Workouts.");
    foreach (var file in WorkoutSessions) {
      RawWorkoutClass rawworkout = new;
      rawworkout.Build(file.Readings);
      RawWorkouts.Add(rawworkout);
      ProgressPercent(progress += progressPer, progressTotal);
    }
  }

  GetText = TextBlock {
    "/* This file is auto generated. Existing data is NOT overwritten and can be modified in place if necessary.  New data is always added to the end of the file. */";
    Empty;
    Empty;
    "RunSessionClass[] RunSessions = [";

    double progress    = 50;
    double progressPer = 25 / WorkoutSessions.Length;
    TextBlock {
      foreach (var session in WorkoutSessions) {
        IndentSpace: 2;
        "new(\"{0}\", ["(session.Filename);

        TextBlock {
          IndentSpace: 2;
          foreach (var reading in session.Readings)
            "new(#{0}#, {1}, {2}, {3}, {4}, {5}),"(reading.Time, reading.Elevation, reading.Meters, reading.Course, reading.HAcc, reading.VAcc);
        };
        "]),";
        if (!ProgressPercent(progress += progressPer, 100))
          break;
      }
    };
    "];";
  };

  void WriteStorage {
    IO.Write(GetText, DataReadingsPath);
  }
}
