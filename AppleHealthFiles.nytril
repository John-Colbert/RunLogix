using IO, Units, Format;

class AppleFileItemClass {
  var DateTime FileNameDate;
  var FileEntryClass File;

  Constructor(DateTime fileNameDate, FileEntryClass file) {
    FileNameDate = fileNameDate;
    File         = file;
  }
}

class AppleHealthFilesClass {
  private readonly var List<AppleFileItemClass> AppleWorkoutFiles;
  private readonly var AccumulatorClass  Accumulator;
  private readonly var List<string> ExistingFileNames;
  readonly var List<RunSessionClass> WorkoutSessions;
  readonly var List<RawWorkoutClass> RawWorkouts;

  Constructor() {
    Progress("Initializing Files", 5);

    var fileCount     = AppleFiles.Length;
    AppleWorkoutFiles = new(fileCount);
    CreateSortableAppleFiles();
    AppleWorkoutFiles.SortField(false, d => d.FileNameDate);
    Accumulator       = new;
    WorkoutSessions   = new(fileCount);
    RawWorkouts       = new(fileCount);
    ExistingFileNames = ProcessNytrilWorkoutFiles();
    ProcessIncomingAppleFiles();
  }

  private void CreateSortableAppleFiles() {
    foreach (var file in AppleFiles) {
      var nameParts           = file.FileName.Split("_");
      var dateParts           = nameParts[1].Split("-");
      var timeParts           = nameParts[2].Split(".");
      var hour                = timeParts[0] as int;
      var timeWithIndicator   = timeParts[1];
      var tiLength            = timeWithIndicator.Length;
      var tIndicator          = timeWithIndicator[(tiLength - 2)..(tiLength - 1)];
      var year                = dateParts[0] as int;
      var month               = dateParts[1] as int;
      var day                 = dateParts[2] as int;
      hour                    = tIndicator == "pm" ? hour + 12 : hour;
      var minutes             = timeWithIndicator.Replace(tIndicator, "") as int;
      DateTime date = new(year, month, day, hour, minutes); //dateParts[0], dateParts[1], dateParts[2], hour, minutes
      var appleFile = new AppleFileItemClass(date, file);
      AppleWorkoutFiles.Add(appleFile);
    }
  }

  private List<string> ProcessNytrilWorkoutFiles() {
    var count = NytrilDataFiles.Length;
    if (count == 0)
      return [];

    var progress    = 5.0;
    var progressMax = 50;
    var progressPer = progressMax / count;

    List<string> retlist = new(count);
    foreach (FileEntryClass file in NytrilDataFiles) {
      progress += progressPer;
      Progress("Adding Nytril Workout File {0}"file.FileName, progress);
      var path     = file.Path;
      var build    = ReadScript(path);
      var session  = build.Root.RunSession as RunSessionClass;
      retlist.AddEach(session.WorkoutFileNames.ToArray);
      WorkoutSessions.Add(session);
      AddToRawWorkouts(session);
    }
    return retlist;
  }

  private void ProcessIncomingAppleFiles() {
    var count = AppleWorkoutFiles.Length;

    var progress    = 50.0;
    var progressMax = 100;
    var progressPer = progressMax / count;

    for (var i = 0; i < count; i++) {
      var file       = AppleWorkoutFiles[i].File;
      var fileName   = file.FileName;
      var errorCount = 0;

      progress += progressPer;
      Progress("Adding Nytril Workout File {0}"fileName, progress);

      if (ExistingFileNames.FindFirstIndex(d => d == fileName) > -1)
        continue;

      var fileDate = GetDateStrFromFile(file);
      if (i + 1 < count) {
        var nextfile     = AppleWorkoutFiles[i + 1].File;
        var nextfileDate = GetDateStrFromFile(nextfile);
        if (fileDate != nextfileDate) {
          var readings = Accumulator.ReadFile(AppleFilesPath, fileName);

          List<string> workoutFileNames = new(1);
          workoutFileNames.Add(fileName);
          AddSessionAndWriteOut(fileName, workoutFileNames, readings, errorCount);
        }
        else {
          List<string> workoutFileNames = new(1);
          workoutFileNames.Add(fileName);

          var readings            = Accumulator.ReadFile(AppleFilesPath, fileName);
          var lastOfFirstReadings = readings[readings.Length - 1];
          var lastDateOfFirst     = lastOfFirstReadings.Time;

          while (fileDate == nextfileDate) {
            var nextFileName    = nextfile.FileName;
            var nextReadings    = Accumulator.ReadFile(AppleFilesPath, nextFileName);
            var firstOfNext     = nextReadings[0];
            var lastOfNext      = nextReadings[nextReadings.Length - 1];
            var firstDateOfNext = firstOfNext.Time;

            var timeDifference = firstDateOfNext - lastDateOfFirst;
            if (Math.Round(timeDifference.Hours) == 0 && Math.Round(timeDifference.Minutes) <= 1) { //&& timeDifference.Seconds <= 2
              workoutFileNames.Add(nextFileName);

              //if readings are missing, then insert missing readings using last value.  We need a complete list accounting for every second.
              int seconds = timeDifference.Seconds as int;
              if (seconds >= 1) {
                errorCount += seconds;
                for (int t = 0; t < seconds; t++) {
                  var tadd = lastDateOfFirst + (t + 1) second;
                  if (tadd < firstDateOfNext) {
                    ReadingItemClass insertReading = new(tadd, lastOfFirstReadings.Elevation, lastOfFirstReadings.Meters, lastOfFirstReadings.Course, lastOfFirstReadings.HAcc, lastOfFirstReadings.VAcc);
                    readings.Add(insertReading);
                  }
                }
              }

              readings.AddEach(nextReadings.ToArray());

              //Get the new last date of readings
              lastOfFirstReadings = lastOfNext;
              lastDateOfFirst     = lastOfFirstReadings.Time;

              //  update next file with next next file
              i++;
              if (i + 1 >= count)
                break;

              nextfile     = AppleWorkoutFiles[i + 1].File;
              nextfileDate = GetDateStrFromFile(nextfile);
            }
            else
              break;
          }
          AddSessionAndWriteOut(fileName, workoutFileNames, readings, errorCount);
        }
      }
    }
  }

  private void AddSessionAndWriteOut(string fileName, List<string> workoutFileNames, List<ReadingItemClass> readings, int errorCount) {
    RunSessionClass session = new(fileName, workoutFileNames, readings.ToArray, errorCount);
    WriteStorageFile(session);
    WorkoutSessions.Add(session);
    AddToRawWorkouts(session);
  }

  private void AddToRawWorkouts(RunSessionClass session) {
    RawWorkoutClass rawworkout = new;
    rawworkout.Build(session.Readings);
    RawWorkouts.Add(rawworkout);
  }

  static string[] FilePaths() {
    return [];
  }

  private string GetDateStrFromFile(FileEntryClass file) {
    var filename = file.FileName;
    var fileNameParts = filename.Split("_");
    return fileNameParts[1];
  }

  private GetWorkoutText(RunSessionClass workoutSession) = TextBlock {
    "/* This file is auto generated. Existing data is NOT overwritten and can be modified in place if necessary. */";
    Empty;
    Empty;
    "RunSessionClass RunSession = new(\"{0}\","(workoutSession.Filename);
    TextBlock {
      IndentSpace: 2;
      "[";
      foreach (var name in workoutSession.WorkoutFileNames)
        "\"{0}\","(name);
      "],"
    };
    TextBlock {
      IndentSpace: 2;
      "[";
      foreach (var reading in workoutSession.Readings)
        "new(#{0}#, {1}, {2}, {3}, {4}, {5}),"(reading.Time, reading.Elevation, reading.Meters, reading.Course, reading.HAcc, reading.VAcc);
    };
    "], {0});"(workoutSession.ErrorCount);
  };

  private void WriteStorageFile(RunSessionClass workoutSession) {
    var fn = workoutSession.Filename.Replace(".gpx", "");
    IO.Write(GetWorkoutText(workoutSession), DataSessionsPath FileName(fn) Extensions.Nytril);
  }
}
